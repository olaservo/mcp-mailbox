{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-mailbox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }],
  // MAILBOX_KEY is a secret: `npx wrangler secret put MAILBOX_KEY`. For `wrangler dev` it comes from .dev.vars.
  "vars": { "OPEN_HOOKS": "0" },
  "env": {
    // A mailbox where anyone can create a hook: `npx wrangler deploy --env demo`.
    "demo": {
      "name": "mcp-mailbox-demo",
      "durable_objects": {
        "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
      },
      "vars": { "OPEN_HOOKS": "1" },
      // Hooks created without the admin key, per address. namespace_id is unique within the account.
      "ratelimits": [{ "name": "HOOK_LIMITER", "namespace_id": "3415", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
