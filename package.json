{
  "name": "mcp-mailbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A mailbox for MCP Events webhook delivery (SEP-3415)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "reader": "node src/reader/cli.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
