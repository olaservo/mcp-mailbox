{
  "name": "@olaservo/mcp-mailbox",
  "version": "0.1.0",
  "type": "module",
  "description": "A mailbox for MCP Events webhook delivery (SEP-3415), and a reader that fetches and verifies events from it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olaservo/mcp-mailbox.git"
  },
  "keywords": ["mcp", "model-context-protocol", "webhooks", "events"],
  "bin": {
    "mcp-mailbox-reader": "dist/reader/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
